# Backend Environment Configuration Template
# Copy this file to backend/.env and fill in your actual credentials

PORT=5000

# Firebase / Firestore Config
FIREBASE_PROJECT_ID=apnakirayana
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://apnakirayana-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=apnakirayana.firebasestorage.app

# Gmail SMTP Configuration for Real Email OTP
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-character password and paste below:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# JWT Session Secret
JWT_SECRET=apnakirana_secret_change_before_production

# Real Mobile SMS Gateway Configuration
# 1. Fast2SMS (Recommended for India: https://www.fast2sms.com)
FAST2SMS_API_KEY=

# 2. 2Factor.in (Indian SMS API: https://2factor.in)
TWOFACTOR_API_KEY=

# 3. Twilio Verify (International SMS API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# 4. WhatsApp OTP Gateway (Unlimited / Free Daily OTPs via WhatsApp - https://ultramsg.com)
WHATSAPP_INSTANCE_ID=instance196197
WHATSAPP_API_KEY=opf961idpyh3ggx8

# Optional Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
